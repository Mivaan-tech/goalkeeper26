    async function leaveH2HMatch() {
        stopH2HPolling();
        hideH2HOverlay();
        if (h2h &amp;&amp; h2h.matchId) {
            try { await fbDelete(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/active&#39;); } catch (e) {}
            if (h2h.opponent) {
                try { await fbDelete(FB_USER_MATCHES + &#39;/&#39; + h2h.opponent + &#39;/invites/&#39; + h2h.matchId); } catch (e) {}
            }
        }
        h2h = null;
        h2hRng = null;
        h2hOpponentHUDEl.classList.remove(&#39;visible&#39;);
    }

    async function startH2HAsHost(friendName) {
        if (!username) return;
        const seed = Math.floor(Math.random() * 0xFFFFFFFF);
        const entry = {
            host: username,
            guest: friendName,
            seed: seed,
            status: &#39;waiting&#39;,
            hostScore: 0,
            guestScore: 0,
            hostDone: false,
            guestDone: false,
            startAt: 0,
            created: Date.now(),
            completed: null
        };
        try {
            const res = await fbPost(FB_MATCHES, entry);
            const id = res.name;
            await fbPut(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/active&#39;, id);
            await fbPut(FB_USER_MATCHES + &#39;/&#39; + friendName + &#39;/invites/&#39; + id, true);
            h2h = { matchId: id, role: &#39;host&#39;, opponent: friendName, seed: seed, state: &#39;waiting&#39; };
            // Close friends screen if open
            friendsScreenEl.classList.remove(&#39;visible&#39;);
            renderH2HWaiting(friendName);
            startH2HPolling();
        } catch (e) {
            alert(&#39;Failed to create H2H match&#39;);
        }
    }

    async function acceptH2HInvite(matchId) {
        try {
            const match = await fbGet(FB_MATCHES + &#39;/&#39; + matchId);
            if (!match) { alert(&#39;Match no longer exists&#39;); return; }
            const startAt = Date.now() + 4000;
            await fbPatch(FB_MATCHES + &#39;/&#39; + matchId, {
                status: &#39;countdown&#39;,
                startAt: startAt
            });
            await fbPut(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/active&#39;, matchId);
            await fbDelete(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/invites/&#39; + matchId);
            h2h = { matchId: matchId, role: &#39;guest&#39;, opponent: match.host, seed: match.seed, state: &#39;countdown&#39; };
            challengesScreenEl.classList.remove(&#39;visible&#39;);
            renderH2HCountdown(Math.ceil((startAt - Date.now()) / 1000), username, match.host);
            startH2HPolling();
        } catch (e) {
            alert(&#39;Failed to join match&#39;);
        }
    }

    async function declineH2HInvite(matchId) {
