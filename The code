    function startH2HPolling() {
        stopH2HPolling();
        h2hPollTimer = setInterval(pollH2H, 500);
        pollH2H();
    }
    function stopH2HPolling() {
        if (h2hPollTimer) { clearInterval(h2hPollTimer); h2hPollTimer = null; }
        if (h2hCountdownTimer) { clearInterval(h2hCountdownTimer); h2hCountdownTimer = null; }
    }

    async function pollH2H() {
        if (!h2h) return;
        let match;
        try { match = await fbGet(FB_MATCHES + &#39;/&#39; + h2h.matchId); }
        catch (e) { return; }
        if (!match) return;

        // Host waits for guest to accept → status becomes &#39;countdown&#39;
        if (h2h.role === &#39;host&#39; &amp;&amp; h2h.state === &#39;waiting&#39; &amp;&amp; match.status === &#39;countdown&#39;) {
            h2h.state = &#39;countdown&#39;;
            beginH2HCountdown(match.startAt);
        }
        // Both: live match started
        if (h2h.state === &#39;countdown&#39; &amp;&amp; match.status === &#39;live&#39;) {
            h2h.state = &#39;live&#39;;
            startH2HPlay(match.seed);
        }
        // Live: update opponent score
        if (h2h.state === &#39;live&#39; &amp;&amp; match.status === &#39;live&#39;) {
            const oppScore = (h2h.role === &#39;host&#39;) ? match.guestScore : match.hostScore;
            updateOpponentHUD(h2h.opponent, oppScore || 0);
            // If both done, complete
            if (match.hostDone &amp;&amp; match.guestDone) {
                if (match.status !== &#39;complete&#39;) {
                    try { await fbPatch(FB_MATCHES + &#39;/&#39; + h2h.matchId, { status: &#39;complete&#39;, completed: Date.now() }); } catch (e) {}
                }
                h2h.state = &#39;complete&#39;;
                stopH2HPolling();
                renderH2HResult(match);
                h2hOpponentHUDEl.classList.remove(&#39;visible&#39;);
            }
        }
        // If server marked complete
        if (match.status === &#39;complete&#39; &amp;&amp; h2h.state !== &#39;complete&#39;) {
            h2h.state = &#39;complete&#39;;
            stopH2HPolling();
            renderH2HResult(match);
            h2hOpponentHUDEl.classList.remove(&#39;visible&#39;);
        }
    }

    function beginH2HCountdown(startAt) {
        const myName = username;
        const oppName = h2h.opponent;
        const tick = async () =&gt; {
            const remaining = startAt - Date.now();
            const secs = Math.max(0, Math.ceil(remaining / 1000));
            renderH2HCountdown(secs || &#39;GO!&#39;, myName, oppName);
            if (remaining &lt;= 0) {
                clearInterval(h2hCountdownTimer);
                h2hCountdownTimer = null;
                if (h2h &amp;&amp; h2h.role === &#39;host&#39;) {
                    try { await fbPatch(FB_MATCHES + &#39;/&#39; + h2h.matchId, { status: &#39;live&#39; }); } catch (e) {}
                }
                // pollH2H will pick up status=&#39;live&#39; and call startH2HPlay
            }
        };
        tick();
        h2hCountdownTimer = setInterval(tick, 250);
    }

    function updateOpponentHUD(name, oppScore) {
        h2hOpponentHUDEl.innerHTML = &#39;&lt;div class=&#34;h2h-name&#34;&gt;&#39; + name + &#39;&lt;/div&gt;&#39; + oppScore;
        h2hOpponentHUDEl.classList.add(&#39;visible&#39;);
    }

    function startH2HPlay(seed) {
        hideH2HOverlay();
        h2hRng = mulberry32(seed);
        h2hLastScoreSent = -1;
        h2hLastDoneSent = false;
        updateOpponentHUD(h2h.opponent, 0);
        startGame();
    }

    async function pushH2HScore(s) {
        if (!h2h || !h2h.matchId) return;
        const field = (h2h.role === &#39;host&#39;) ? &#39;hostScore&#39; : &#39;guestScore&#39;;
        const payload = {}; payload[field] = s;
        try { await fbPatch(FB_MATCHES + &#39;/&#39; + h2h.matchId, payload); } catch (e) {}
    }

    async function pushH2HDone(finalScore) {
        if (!h2h || !h2h.matchId) return;
        const scoreField = (h2h.role === &#39;host&#39;) ? &#39;hostScore&#39; : &#39;guestScore&#39;;
        const doneField = (h2h.role === &#39;host&#39;) ? &#39;hostDone&#39; : &#39;guestDone&#39;;
        const payload = {}; payload[scoreField] = finalScore; payload[doneField] = true;
        try { await fbPatch(FB_MATCHES + &#39;/&#39; + h2h.matchId, payload); } catch (e) {}
    }

    // Render H2H invites in Challenges screen
    async function renderH2HInvites() {
        h2hInvitesEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;Loading…&lt;/div&gt;&#39;;
        let data;
        try { data = await fbGet(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/invites&#39;); }
        catch (e) { h2hInvitesEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;Offline&lt;/div&gt;&#39;; return; }
        const ids = data ? Object.keys(data) : [];
        if (ids.length === 0) {
            h2hInvitesEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;No H2H invites&lt;/div&gt;&#39;;
            return;
        }
        const matches = await Promise.all(ids.map(id =&gt;
            fbGet(FB_MATCHES + &#39;/&#39; + id).then(m =&gt; m ? { id, ...m } : null).catch(() =&gt; null)
        ));
        const valid = matches.filter(m =&gt; m &amp;&amp; m.status === &#39;waiting&#39;);
        if (valid.length === 0) {
            h2hInvitesEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;No H2H invites&lt;/div&gt;&#39;;
            // Clean up stale invites
            ids.forEach(id =&gt; fbDelete(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/invites/&#39; + id));
            return;
        }
        h2hInvitesEl.innerHTML = &#39;&#39;;
        valid.forEach(m =&gt; {
            const row = document.createElement(&#39;div&#39;);
            row.className = &#39;challenge-row&#39;;
            const header = document.createElement(&#39;div&#39;);
            header.className = &#39;ch-header&#39;;
            const from = document.createElement(&#39;span&#39;);
            from.className = &#39;ch-from&#39;;
            from.textContent = &#39;From &#39; + m.host;
            const tgt = document.createElement(&#39;span&#39;);
            tgt.className = &#39;ch-target&#39;;
            tgt.textContent = &#39;Head-to-Head&#39;;
            header.appendChild(from);
            header.appendChild(tgt);
            row.appendChild(header);
            const actions = document.createElement(&#39;div&#39;);
            actions.className = &#39;ch-actions&#39;;
            const join = document.createElement(&#39;button&#39;);
            join.className = &#39;ch-action-btn play&#39;;
            join.textContent = &#39;Join&#39;;
            join.addEventListener(&#39;click&#39;, () =&gt; acceptH2HInvite(m.id));
            const dec = document.createElement(&#39;button&#39;);
            dec.className = &#39;ch-action-btn dismiss&#39;;
            dec.textContent = &#39;Decline&#39;;
            dec.addEventListener(&#39;click&#39;, () =&gt; declineH2HInvite(m.id));
            actions.appendChild(join);
            actions.appendChild(dec);
            row.appendChild(actions);
            h2hInvitesEl.appendChild(row);
        });
    }

