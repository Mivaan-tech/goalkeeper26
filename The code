    async function renderChallenges() {
        challengesIncomingEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;Loading…&lt;/div&gt;&#39;;
        challengesOutgoingEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;Loading…&lt;/div&gt;&#39;;
        let refs;
