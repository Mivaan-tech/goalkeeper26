    function makeChallengeResultLabel(challenge, perspective) {
        // perspective: &#39;incoming&#39; (I was challenged) or &#39;outgoing&#39; (I sent it)
        const t = challenge.target;
        const s = challenge.toScore;
        if (challenge.status !== &#39;complete&#39; || s == null) return null;
        const beat = s &gt; t;
        if (perspective === &#39;incoming&#39;) {
            return beat
                ? { text: &#39;You beat the target! (&#39; + s + &#39; vs &#39; + t + &#39;)&#39;, cls: &#39;win&#39; }
                : { text: &#39;You fell short (&#39; + s + &#39; vs &#39; + t + &#39;)&#39;, cls: &#39;loss&#39; };
        }
        return beat
            ? { text: challenge.to + &#39; beat your &#39; + t + &#39; with &#39; + s, cls: &#39;loss&#39; }
            : { text: challenge.to + &#39; tried but got &#39; + s + &#39; / &#39; + t, cls: &#39;win&#39; };
    }

