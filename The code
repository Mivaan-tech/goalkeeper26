    // --- Enthusiastic crowd cheer: whistles + cheering + &#34;come on!&#34; energy ---
    function playCrowdCheer() {
        const ctx = getAudioCtx();
        const duration = 2.015;

        // Layer 1 — massive crowd roar (low rumble building fast)
        const buf1 = ctx.createBuffer(1, ctx.sampleRate * duration, ctx.sampleRate);
        const d1 = buf1.getChannelData(0);
        for (let i = 0; i &lt; d1.length; i++) {
            const t = i / ctx.sampleRate;
            const env = Math.min(t / 0.04, 1) * Math.pow(Math.sin(t * Math.PI / duration), 0.4);
            d1[i] = (Math.random() * 2 - 1) * env;
        }
        const src1 = ctx.createBufferSource();
        src1.buffer = buf1;
        const filt1 = ctx.createBiquadFilter();
        filt1.type = &#39;lowpass&#39;;
        filt1.frequency.value = 800;
        const g1 = ctx.createGain();
        g1.gain.setValueAtTime(0, ctx.currentTime);
        g1.gain.linearRampToValueAtTime(0.5, ctx.currentTime + 0.06);
        g1.gain.linearRampToValueAtTime(0.4, ctx.currentTime + 1.0);
        g1.gain.linearRampToValueAtTime(0, ctx.currentTime + duration);
        src1.connect(filt1); filt1.connect(g1); g1.connect(ctx.destination);
        src1.start(ctx.currentTime);

        // Layer 2 — excited mid-high crowd screaming/cheering
        const buf2 = ctx.createBuffer(1, ctx.sampleRate * duration, ctx.sampleRate);
        const d2 = buf2.getChannelData(0);
        for (let i = 0; i &lt; d2.length; i++) {
            const t = i / ctx.sampleRate;
            const env = Math.min(t / 0.03, 1) * Math.pow(Math.sin(t * Math.PI / duration), 0.5);
            d2[i] = (Math.random() * 2 - 1) * env;
        }
        const src2 = ctx.createBufferSource();
        src2.buffer = buf2;
        const filt2 = ctx.createBiquadFilter();
        filt2.type = &#39;bandpass&#39;;
        filt2.frequency.setValueAtTime(1500, ctx.currentTime);
        filt2.frequency.linearRampToValueAtTime(3500, ctx.currentTime + 0.15);
        filt2.frequency.linearRampToValueAtTime(2500, ctx.currentTime + 1.0);
        filt2.Q.value = 0.3;
        const g2 = ctx.createGain();
        g2.gain.setValueAtTime(0, ctx.currentTime);
        g2.gain.linearRampToValueAtTime(0.55, ctx.currentTime + 0.05);
        g2.gain.linearRampToValueAtTime(0.4, ctx.currentTime + 0.8);
        g2.gain.linearRampToValueAtTime(0, ctx.currentTime + duration);
        src2.connect(filt2); filt2.connect(g2); g2.connect(ctx.destination);
        src2.start(ctx.currentTime);

        // Layer 3 — multiple scattered whistles throughout
        const whistleTimes = [0, 0.12, 0.28, 0.4, 0.52, 0.65, 0.78, 0.9, 1.02, 1.15, 1.3, 1.5];
        whistleTimes.forEach(delay =&gt; {
            const osc = ctx.createOscillator();
            const wg = ctx.createGain();
            osc.connect(wg); wg.connect(ctx.destination);
            osc.type = &#39;sine&#39;;
            const baseFreq = 2600 + Math.random() * 600;
            osc.frequency.setValueAtTime(baseFreq, ctx.currentTime + delay);
            osc.frequency.linearRampToValueAtTime(baseFreq + 200 + Math.random() * 300, ctx.currentTime + delay + 0.15);
            osc.frequency.linearRampToValueAtTime(baseFreq - 100, ctx.currentTime + delay + 0.25);
            const vol = 0.22 + Math.random() * 0.1;
            wg.gain.setValueAtTime(0, ctx.currentTime + delay);
            wg.gain.linearRampToValueAtTime(vol, ctx.currentTime + delay + 0.02);
            wg.gain.linearRampToValueAtTime(vol * 0.8, ctx.currentTime + delay + 0.15);
            wg.gain.linearRampToValueAtTime(0, ctx.currentTime + delay + 0.28);
            osc.start(ctx.currentTime + delay);
            osc.stop(ctx.currentTime + delay + 0.28);
        });

        // Layer 4 — rhythmic clapping/stomping underneath (fast &#34;come on!&#34; rhythm)
        for (let c = 0; c &lt; 10; c++) {
            const clapTime = ctx.currentTime + 0.1 + c * 0.15;
            if (clapTime &gt; ctx.currentTime + duration) break;
            const bufSize = Math.floor(ctx.sampleRate * 0.04);
            const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
            const d = buf.getChannelData(0);
            for (let i = 0; i &lt; bufSize; i++) {
                d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufSize, 2.5);
            }
            const src = ctx.createBufferSource();
            src.buffer = buf;
            const filt = ctx.createBiquadFilter();
            filt.type = &#39;bandpass&#39;;
            filt.frequency.value = 1500 + Math.random() * 500;
            filt.Q.value = 0.6;
            const cg = ctx.createGain();
            const cVol = (c &lt; 6 ? 0.3 + c * 0.04 : 0.5 - (c - 6) * 0.08);
            cg.gain.setValueAtTime(cVol, clapTime);
            cg.gain.linearRampToValueAtTime(0, clapTime + 0.04);
            src.connect(filt); filt.connect(cg); cg.connect(ctx.destination);
            src.start(clapTime);
        }

        // Layer 5 — high energy burst at the start (initial gasp/explosion)
        const burstBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.3), ctx.sampleRate);
        const burstD = burstBuf.getChannelData(0);
        for (let i = 0; i &lt; burstD.length; i++) {
            const t = i / ctx.sampleRate;
            burstD[i] = (Math.random() * 2 - 1) * Math.pow(1 - t / 0.3, 2);
        }
        const burstSrc = ctx.createBufferSource();
        burstSrc.buffer = burstBuf;
        const burstFilt = ctx.createBiquadFilter();
        burstFilt.type = &#39;highpass&#39;;
        burstFilt.frequency.value = 2000;
        const burstGain = ctx.createGain();
        burstGain.gain.setValueAtTime(0.35, ctx.currentTime);
        burstGain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);
        burstSrc.connect(burstFilt); burstFilt.connect(burstGain); burstGain.connect(ctx.destination);
        burstSrc.start(ctx.currentTime);
    }

    function playThunderClapStorm() {
        const ctx = getAudioCtx();
        const duration = 1.6;
        // Layer 1 — massive thunderous rolling claps
        const clapCount = 20;
        for (let c = 0; c &lt; clapCount; c++) {
            const clapTime = ctx.currentTime + c * 0.07 + Math.random() * 0.03;
            const bufSize = Math.floor(ctx.sampleRate * 0.06);
            const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
            const d = buf.getChannelData(0);
            for (let i = 0; i &lt; bufSize; i++) {
                d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufSize, 2);
            }
            const src = ctx.createBufferSource();
            src.buffer = buf;
            const filt = ctx.createBiquadFilter();
            filt.type = &#39;bandpass&#39;;
            filt.frequency.value = 1200 + Math.random() * 800;
            filt.Q.value = 0.5;
            const cg = ctx.createGain();
            // Build up then fade out
            const progress = c / clapCount;
            const vol = (progress &lt; 0.4 ? progress / 0.4 : 1 - (progress - 0.4) / 0.6) * 0.55;
            cg.gain.setValueAtTime(vol, clapTime);
            cg.gain.linearRampToValueAtTime(0, clapTime + 0.06);
            src.connect(filt); filt.connect(cg); cg.connect(ctx.destination);
            src.start(clapTime);
        }
        // Layer 2 — deep reverberant thunder rumble underneath
        const tBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
        const tD = tBuf.getChannelData(0);
        for (let i = 0; i &lt; tD.length; i++) {
            const t = i / ctx.sampleRate;
            const env = Math.min(t / 0.1, 1) * Math.pow(1 - t / duration, 0.7);
            tD[i] = (Math.random() * 2 - 1) * env;
        }
        const tSrc = ctx.createBufferSource();
        tSrc.buffer = tBuf;
        const tFilt = ctx.createBiquadFilter();
        tFilt.type = &#39;lowpass&#39;;
        tFilt.frequency.value = 400;
        const tGain = ctx.createGain();
        tGain.gain.setValueAtTime(0, ctx.currentTime);
        tGain.gain.linearRampToValueAtTime(0.4, ctx.currentTime + 0.15);
        tGain.gain.linearRampToValueAtTime(0.3, ctx.currentTime + 0.8);
        tGain.gain.linearRampToValueAtTime(0, ctx.currentTime + duration);
        tSrc.connect(tFilt); tFilt.connect(tGain); tGain.connect(ctx.destination);
        tSrc.start(ctx.currentTime);
        // Layer 3 — bright crowd excitement on top
        const eBuf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 1.0), ctx.sampleRate);
        const eD = eBuf.getChannelData(0);
        for (let i = 0; i &lt; eD.length; i++) {
            const t = i / ctx.sampleRate;
            eD[i] = (Math.random() * 2 - 1) * Math.pow(Math.sin(t * Math.PI / 1.0), 0.5);
        }
        const eSrc = ctx.createBufferSource();
        eSrc.buffer = eBuf;
        const eFilt = ctx.createBiquadFilter();
        eFilt.type = &#39;highpass&#39;;
        eFilt.frequency.value = 1500;
        const eGain = ctx.createGain();
        eGain.gain.setValueAtTime(0, ctx.currentTime);
        eGain.gain.linearRampToValueAtTime(0.2, ctx.currentTime + 0.1);
        eGain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.0);
        eSrc.connect(eFilt); eFilt.connect(eGain); eGain.connect(ctx.destination);
        eSrc.start(ctx.currentTime);
    }

