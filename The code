            challengesOutgoingEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;Offline&lt;/div&gt;&#39;;
            return;
        }
        const incomingIds = Object.keys(refs.incoming);
        const outgoingIds = Object.keys(refs.outgoing);
        const [incoming, outgoing] = await Promise.all([
            fetchChallengesById(incomingIds),
            fetchChallengesById(outgoingIds)
        ]);
        const incomingClean = incoming.filter(x =&gt; x);
        const outgoingClean = outgoing.filter(x =&gt; x);
        incomingClean.sort((a, b) =&gt; (b.created || 0) - (a.created || 0));
        outgoingClean.sort((a, b) =&gt; (b.created || 0) - (a.created || 0));

        if (incomingClean.length === 0) {
            challengesIncomingEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;No incoming challenges&lt;/div&gt;&#39;;
        } else {
            challengesIncomingEl.innerHTML = &#39;&#39;;
            incomingClean.forEach(c =&gt; challengesIncomingEl.appendChild(renderIncomingChallenge(c)));
        }
        if (outgoingClean.length === 0) {
            challengesOutgoingEl.innerHTML = &#39;&lt;div class=&#34;friends-empty&#34;&gt;No sent challenges&lt;/div&gt;&#39;;
        } else {
            challengesOutgoingEl.innerHTML = &#39;&#39;;
            outgoingClean.forEach(c =&gt; challengesOutgoingEl.appendChild(renderOutgoingChallenge(c)));
        }
        updateChallengeBadgeFromData(incomingClean);
    }

