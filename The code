    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js">
    </script>
    <script>
      // ============ THREE.JS SETUP ============
    const scene = new THREE.Scene();

    // Blue sunny sky gradient
    const skyCanvas = document.createElement(&#39;canvas&#39;);
    skyCanvas.width = 1;
    skyCanvas.height = 512;
    const skyCtx = skyCanvas.getContext(&#39;2d&#39;);
    const skyGrad = skyCtx.createLinearGradient(0, 0, 0, 512);
    skyGrad.addColorStop(0, &#39;#1e90ff&#39;);    // bright blue at top
    skyGrad.addColorStop(0.4, &#39;#63b3ed&#39;);  // lighter blue
    skyGrad.addColorStop(0.7, &#39;#90cdf4&#39;);  // pale blue near horizon
    skyGrad.addColorStop(1.0, &#39;#e8f4f8&#39;);  // almost white at horizon
    skyCtx.fillStyle = skyGrad;
    skyCtx.fillRect(0, 0, 1, 512);
    const skyTexture = new THREE.CanvasTexture(skyCanvas);
    scene.background = skyTexture;
    scene.fog = new THREE.Fog(0x90cdf4, 40, 80);

    // Sun
    const sunGeo = new THREE.SphereGeometry(2, 16, 16);
    const sunMat = new THREE.MeshBasicMaterial({ color: 0xffee58 });
    const sunMesh = new THREE.Mesh(sunGeo, sunMat);
    sunMesh.position.set(15, 30, -30);
    scene.add(sunMesh);

    // Sun glow
    const glowGeo = new THREE.SphereGeometry(3.5, 16, 16);
    const glowMat = new THREE.MeshBasicMaterial({ color: 0xfff9c4, transparent: true, opacity: 0.3 });
    const glowMesh = new THREE.Mesh(glowGeo, glowMat);
    glowMesh.position.copy(sunMesh.position);
    scene.add(glowMesh);

    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 200);
    camera.position.set(0, 22, 18);
    camera.lookAt(0, 0, -2);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    document.body.insertBefore(renderer.domElement, document.body.firstChild);

    window.addEventListener(&#39;resize&#39;, () =&gt; {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // ============ LIGHTING ============
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1.0);
    dirLight.position.set(10, 20, 10);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 1024;
    dirLight.shadow.mapSize.height = 1024;
    dirLight.shadow.camera.near = 0.5;
    dirLight.shadow.camera.far = 60;
    dirLight.shadow.camera.left = -25;
    dirLight.shadow.camera.right = 25;
    dirLight.shadow.camera.top = 25;
    dirLight.shadow.camera.bottom = -25;
    scene.add(dirLight);

    // ============ GROUND ============
    const FIELD_WIDTH = 30;
    const FIELD_DEPTH = 20;

    // Create grass texture procedurally
    const grassCanvas = document.createElement(&#39;canvas&#39;);
    grassCanvas.width = 512;
    grassCanvas.height = 512;
    const gCtx = grassCanvas.getContext(&#39;2d&#39;);
    // Base green
    gCtx.fillStyle = &#39;#3a7a33&#39;;
    gCtx.fillRect(0, 0, 512, 512);
    // Random grass patches for variation
    for (let i = 0; i &lt; 8000; i++) {
        const gx = Math.random() * 512;
        const gy = Math.random() * 512;
        const shade = Math.floor(Math.random() * 40);
        const r = 40 + shade;
        const g = 100 + Math.floor(Math.random() * 60);
        const b = 30 + shade;
        gCtx.fillStyle = `rgb(${r},${g},${b})`;
        gCtx.fillRect(gx, gy, 1 + Math.random() * 3, 1 + Math.random() * 6);
    }
    // Lighter patches
    for (let i = 0; i &lt; 2000; i++) {
        const gx = Math.random() * 512;
        const gy = Math.random() * 512;
        gCtx.fillStyle = `rgba(120, 180, 80, ${0.1 + Math.random() * 0.15})`;
        gCtx.fillRect(gx, gy, 2 + Math.random() * 4, 2 + Math.random() * 4);
    }
    const grassTexture = new THREE.CanvasTexture(grassCanvas);
    grassTexture.wrapS = THREE.RepeatWrapping;
    grassTexture.wrapT = THREE.RepeatWrapping;
    grassTexture.repeat.set(4, 3);

    // Main ground with grass texture
    const groundGeo = new THREE.PlaneGeometry(FIELD_WIDTH, FIELD_DEPTH);
    const groundMat = new THREE.MeshStandardMaterial({ map: grassTexture, roughness: 0.95 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // 3D grass blades
    const grassBladeCount = 3000;
    const grassPositions = [];
    const grassColors = [];
    for (let i = 0; i &lt; grassBladeCount; i++) {
        const gx = (Math.random() - 0.5) * FIELD_WIDTH;
        const gz = (Math.random() - 0.5) * FIELD_DEPTH;
        const height = 0.15 + Math.random() * 0.35;
        const lean = (Math.random() - 0.5) * 0.15;
        // Base of blade
        grassPositions.push(gx - 0.02, 0, gz);
        grassPositions.push(gx + 0.02, 0, gz);
        // Tip of blade
        grassPositions.push(gx + lean, height, gz + lean);
        // Second triangle
        grassPositions.push(gx + 0.02, 0, gz);
        grassPositions.push(gx - 0.02, 0, gz + 0.04);
        grassPositions.push(gx + lean, height, gz + lean);
        // Colors — darker at base, lighter at tip
        const baseG = 0.25 + Math.random() * 0.15;
        const tipG = 0.45 + Math.random() * 0.25;
        for (let t = 0; t &lt; 2; t++) {
            grassColors.push(0.15, baseG, 0.1);
            grassColors.push(0.15, baseG, 0.1);
            grassColors.push(0.2, tipG, 0.12);
        }
    }
    const grassGeo = new THREE.BufferGeometry();
    grassGeo.setAttribute(&#39;position&#39;, new THREE.Float32BufferAttribute(grassPositions, 3));
    grassGeo.setAttribute(&#39;color&#39;, new THREE.Float32BufferAttribute(grassColors, 3));
    const grassMat = new THREE.MeshBasicMaterial({ vertexColors: true, side: THREE.DoubleSide });
    const grassMesh = new THREE.Mesh(grassGeo, grassMat);
    scene.add(grassMesh);

    // Field boundary lines
    const borderGeo = new THREE.EdgesGeometry(new THREE.PlaneGeometry(FIELD_WIDTH, FIELD_DEPTH));
    const borderMat = new THREE.LineBasicMaterial({ color: 0xffffff, opacity: 0.7, transparent: true });
    const border = new THREE.LineSegments(borderGeo, borderMat);
    border.rotation.x = -Math.PI / 2;
    border.position.y = 0.02;
    scene.add(border);

    // ============ SOCCER PITCH MARKINGS (half-pitch) ============
    const pitchLineMat = new THREE.LineBasicMaterial({ color: 0xffffff, opacity: 0.7, transparent: true });
    const LY = 0.03; // line height (just above ground)

    function addPitchLine(points) {
        const pts = points.map(p =&gt; new THREE.Vector3(p[0], LY, p[1]));
        const geo = new THREE.BufferGeometry().setFromPoints(pts);
        scene.add(new THREE.Line(geo, pitchLineMat));
    }

    // Half-way line (front edge, Z = -FIELD_DEPTH/2)
    const halfZ = -FIELD_DEPTH / 2;
    addPitchLine([[-FIELD_WIDTH / 2, halfZ], [FIELD_WIDTH / 2, halfZ]]);

    // Center circle (semi-circle curving INTO the pitch from front edge)
    const centerRadius = 5;
    const circlePoints = [];
    for (let i = 0; i &lt;= 32; i++) {
        const angle = (i / 32) * Math.PI; // 0 to PI (semicircle curving into +Z)
        circlePoints.push([
            Math.cos(angle) * centerRadius,
            halfZ + Math.sin(angle) * centerRadius
        ]);
    }
    addPitchLine(circlePoints);

    // Center spot
    const centerSpotGeo = new THREE.CircleGeometry(0.2, 8);
    const centerSpotMat = new THREE.MeshBasicMaterial({ color: 0xffffff, opacity: 0.7, transparent: true });
    const centerSpot = new THREE.Mesh(centerSpotGeo, centerSpotMat);
    centerSpot.rotation.x = -Math.PI / 2;
    centerSpot.position.set(0, LY, halfZ);
    scene.add(centerSpot);

    // Penalty box (18-yard box) — in front of goal
    const penBoxW = 20;  // width
    const penBoxD = 6;   // depth from goal line
    const penBoxZ = FIELD_DEPTH / 2 - penBoxD; // front edge of penalty box
    addPitchLine([
        [-penBoxW / 2, FIELD_DEPTH / 2],
        [-penBoxW / 2, penBoxZ],
        [penBoxW / 2, penBoxZ],
        [penBoxW / 2, FIELD_DEPTH / 2]
    ]);

    // Goal box (6-yard box) — smaller box inside penalty box
    const goalBoxW = 12;
    const goalBoxD = 2.5;
    const goalBoxZ = FIELD_DEPTH / 2 - goalBoxD;
    addPitchLine([
        [-goalBoxW / 2, FIELD_DEPTH / 2],
        [-goalBoxW / 2, goalBoxZ],
        [goalBoxW / 2, goalBoxZ],
        [goalBoxW / 2, FIELD_DEPTH / 2]
    ]);

    // Penalty spot
    const penSpotZ = FIELD_DEPTH / 2 - 4; // Z = +6
    const penSpotGeo = new THREE.CircleGeometry(0.15, 8);
    const penSpot = new THREE.Mesh(penSpotGeo, centerSpotMat);
    penSpot.rotation.x = -Math.PI / 2;
    penSpot.position.set(0, LY, penSpotZ);
    scene.add(penSpot);

    // Penalty arc (arc outside penalty box, centered on penalty spot)
    const penArcRadius = 3;
    const penArcPoints = [];
    for (let i = 0; i &lt;= 24; i++) {
        const angle = Math.PI + (i / 24) * Math.PI; // semicircle
        const px = Math.cos(angle) * penArcRadius;
        const pz = penSpotZ + Math.sin(angle) * penArcRadius;
        // Only draw the part outside the penalty box (Z &lt; penBoxZ)
        if (pz &lt;= penBoxZ + 0.05) {
            penArcPoints.push([px, pz]);
        }
    }
    if (penArcPoints.length &gt; 1) addPitchLine(penArcPoints);

    // Corner arcs (back two corners)
    const cornerRadius = 1;
    // Back-left corner (X = -15, Z = +10)
    const blCorner = [];
    for (let i = 0; i &lt;= 8; i++) {
        const angle = 0 + (i / 8) * (Math.PI / 2); // 0 to PI/2
        blCorner.push([
            -FIELD_WIDTH / 2 + Math.cos(angle) * cornerRadius,
            FIELD_DEPTH / 2 - Math.sin(angle) * cornerRadius
        ]);
    }
    addPitchLine(blCorner);

    // Back-right corner (X = +15, Z = +10)
    const brCorner = [];
    for (let i = 0; i &lt;= 8; i++) {
        const angle = Math.PI / 2 + (i / 8) * (Math.PI / 2); // PI/2 to PI
        brCorner.push([
            FIELD_WIDTH / 2 + Math.cos(angle) * cornerRadius,
            FIELD_DEPTH / 2 - Math.sin(angle) * cornerRadius
        ]);
    }
    addPitchLine(brCorner);

    // ============ GOAL (behind the field) ============
    const GOAL_WIDTH = 14;
    const GOAL_HEIGHT = 4.5;
    const GOAL_DEPTH = 3;
    const GOAL_Z = FIELD_DEPTH / 2 + GOAL_DEPTH / 2; // behind the back edge

    const goalPostMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.3, metalness: 0.6 });
