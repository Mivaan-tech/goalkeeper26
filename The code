    // ============ GAME FUNCTIONS ============
    function endGame(lostAllLives) {
        const isNewBest = score &gt; highScore;
        if (isNewBest) {
            highScore = score;
            localStorage.setItem(&#39;ballCatcherHighScore&#39;, highScore);
        }
        if (username &amp;&amp; score &gt; 0) {
            submitScore(username, score);
            if (isNewBest) saveUserBest();
        }
        if (challengeContext) {
            const ctx = challengeContext;
            recordChallengeResult(ctx.id, score);
            challengeContext = null;
            challengeTargetHUDEl.classList.remove(&#39;visible&#39;);
            const beat = score &gt; ctx.target;
            if (beat) statsOnChallengeWon();
            const msg = beat
                ? &#39;🏆 You beat &#39; + ctx.from + &#39;\&#39;s &#39; + ctx.target + &#39;!&#39;
                : &#39;Got &#39; + score + &#39; / &#39; + ctx.target + &#39; — try again&#39;;
            setTimeout(() =&gt; showCommentary(msg), 200);
            refreshChallengeBadge();
        }
        statsOnGameEnd(score);
        if (h2h &amp;&amp; h2h.state === &#39;live&#39; &amp;&amp; !h2hLastDoneSent) {
            h2hLastDoneSent = true;
            pushH2HDone(score);
            gameOverScreen.classList.add(&#39;hidden&#39;);
            hudEl.classList.add(&#39;hidden&#39;);
            showH2HOverlay(
                &#39;&lt;h2&gt;You finished!&lt;/h2&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-sub&#34;&gt;Your score: &lt;b style=&#34;color:#ffcc02&#34;&gt;&#39; + score + &#39;&lt;/b&gt;&lt;/div&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-sub&#34;&gt;Waiting for &#39; + h2h.opponent + &#39; to finish…&lt;/div&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-countdown&#34;&gt;⏳&lt;/div&gt;&#39;
            );
        }
        gameState = &#39;gameover&#39;;
        hudEl.classList.add(&#39;hidden&#39;);
        pauseScreen.classList.add(&#39;hidden&#39;);
        playerMesh.visible = false;
        ball.active = false;
        ballMesh.visible = false;
        ballShadow.visible = false;
        finalScoreEl.textContent = &#39;Score: &#39; + score;
        finalHighScoreEl.textContent = &#39;High Score: &#39; + highScore;
        homeHighScoreEl.textContent = &#39;High Score: &#39; + highScore;
        gameOverScreen.classList.remove(&#39;hidden&#39;);
        playGameOver();
        if (lostAllLives) {
            showCommentary(gameOverComments[Math.floor(Math.random() * gameOverComments.length)]);
            playCommentatorDisappointed();
        }
    }

    function pauseGame() {
        if (gameState === &#39;playing&#39; &amp;&amp; canPause &amp;&amp; !ball.active) {
            gameState = &#39;paused&#39;;
            pauseScreen.classList.remove(&#39;hidden&#39;);
            updatePauseBtn();
        }
    }

    function resumeGame() {
        if (gameState === &#39;paused&#39;) {
            gameState = &#39;playing&#39;;
            pauseScreen.classList.add(&#39;hidden&#39;);
            lastTime = performance.now();
            updatePauseBtn();
        }
    }

    function updatePauseBtn() {
        const btn = document.getElementById(&#39;pauseBtn&#39;);
        if (gameState === &#39;paused&#39;) {
            btn.textContent = &#39;▶&#39;;
            btn.setAttribute(&#39;aria-label&#39;, &#39;Resume&#39;);
            btn.disabled = false;
        } else {
            btn.textContent = &#39;⏸&#39;;
            btn.setAttribute(&#39;aria-label&#39;, &#39;Pause&#39;);
            btn.disabled = !(gameState === &#39;playing&#39; &amp;&amp; canPause &amp;&amp; !ball.active);
        }
    }

    function startGame() {
        h2hLastScoreSent = -1;
        h2hLastDoneSent = false;
        statsOnGameStart();
        score = 0;
        lives = 3;
        player.x = 0;
        player.z = 0;
        player.prevX = 0;
        player.prevZ = 0;
        player.speed = BASE_PLAYER_SPEED;
        ball.active = false;
        ballMesh.visible = false;
        ballShadow.visible = false;
        playerMesh.visible = true;
        kickTimer = 0;
        kickPhase = &#39;none&#39;;
        ballHeld = false;
        rightLegPivot.rotation.x = 0;
        saveStreak = 0;
        commentaryTimer = 0;
        commentaryEl.classList.remove(&#39;visible&#39;);
        gameState = &#39;playing&#39;;
        canPause = true;
        waitTimer = getInterval(2750);
        waitDuration = waitTimer;
        lastTime = performance.now();

        // Show HUD, hide screens
        playerNameEl.textContent = username ? &#39;👤 &#39; + username : (isGuest ? &#39;👤 Guest&#39; : &#39;&#39;);
        hudEl.classList.remove(&#39;hidden&#39;);
        homeScreen.classList.add(&#39;hidden&#39;);
        gameOverScreen.classList.add(&#39;hidden&#39;);
        pauseScreen.classList.add(&#39;hidden&#39;);

        updateHUD();
    }

    function getDifficultyMultiplier() {
        return 1 + score * 0.15;
    }

    function getInterval(base) {
        // Interval shrinks as score increases, minimum 800ms
        return Math.max(800, base / getDifficultyMultiplier());
    }

    function spawnBall() {
        const speedMult = getDifficultyMultiplier();
        const speed = BASE_BALL_SPEED * speedMult;

        // Ball always spawns ahead of the field (front edge) and flies toward the goal
        ball.x = (spawnRng() - 0.5) * (FIELD_WIDTH - 4);
        ball.z = -FIELD_DEPTH / 2 - 6;
        ball.y = BALL_RADIUS_3D + 0.5;

        // Aim toward the goal area (back of field) with some randomness
        const targetX = (spawnRng() - 0.5) * GOAL_WIDTH;
        const targetZ = FIELD_DEPTH / 2 + 1;
        const dx = targetX - ball.x;
        const dz = targetZ - ball.z;
        const dist = Math.sqrt(dx * dx + dz * dz);
        ball.vx = (dx / dist) * speed;
        ball.vy = 0;
        ball.vz = (dz / dist) * speed;

        ball.active = true;
        ball.enteredField = false;
        ball.rebounded = false;
        ballMesh.visible = true;
        ballShadow.visible = true;
    }

    function updatePlayer(dt) {
        player.prevX = player.x;
        player.prevZ = player.z;

        const speedMult = getDifficultyMultiplier();
        player.speed = BASE_PLAYER_SPEED * speedMult;
        const moveAmount = player.speed * dt * 60;

        // Keyboard
        if (keys[&#39;ArrowLeft&#39;] || keys[&#39;Left&#39;]) player.x -= moveAmount;
        if (keys[&#39;ArrowRight&#39;] || keys[&#39;Right&#39;]) player.x += moveAmount;
        if (keys[&#39;ArrowUp&#39;] || keys[&#39;Up&#39;]) player.z -= moveAmount;
        if (keys[&#39;ArrowDown&#39;] || keys[&#39;Down&#39;]) player.z += moveAmount;

        // Touch
        if (touchTarget) {
            const dx = touchTarget.x - player.x;
            const dz = touchTarget.z - player.z;
            const dist = Math.sqrt(dx * dx + dz * dz);
            if (dist &gt; 0.1) {
                const step = Math.min(moveAmount, dist);
                player.x += (dx / dist) * step;
                player.z += (dz / dist) * step;
            } else {
                player.x = touchTarget.x;
                player.z = touchTarget.z;
                touchTarget = null;
            }
        }

        // Boundaries — player can move across the whole field
        const halfW = FIELD_WIDTH / 2 - PLAYER_SIZE / 2;
        const halfD = FIELD_DEPTH / 2 - PLAYER_SIZE / 2;
        if (player.x &lt; -halfW) player.x = -halfW;
        if (player.x &gt; halfW) player.x = halfW;
        if (player.z &lt; -halfD) player.z = -halfD;
        if (player.z &gt; halfD) player.z = halfD;

        // Update mesh
        playerMesh.position.x = player.x;
        playerMesh.position.z = player.z;
    }

    function updateKickAnimation(dt) {
        if (kickPhase === &#39;none&#39;) {
            rightLegPivot.rotation.x = 0;
            return;
        }

        kickTimer -= dt;
        if (kickTimer &lt; 0) kickTimer = 0;

        if (kickPhase === &#39;windup&#39;) {
            // Leg swings forward — ball held at player&#39;s foot
            const t = 1.0 - (kickTimer / KICK_WINDUP);  // 0 -&gt; 1
            rightLegPivot.rotation.x = KICK_ANGLE * t;

            // Hold ball near the player&#39;s kicking foot
            if (ballHeld) {
                ball.x = player.x + 0.12 + Math.sin(-KICK_ANGLE * t) * 0.5;
                ball.z = player.z - Math.cos(-KICK_ANGLE * t) * 0.5;
                ball.y = BALL_RADIUS_3D + 0.1;
                ballMesh.position.set(ball.x, ball.y, ball.z);
                ballShadow.position.x = ball.x;
                ballShadow.position.z = ball.z;
            }

            if (kickTimer &lt;= 0) {
                // Leg reached peak — launch the ball!
                kickPhase = &#39;contact&#39;;
                kickTimer = KICK_CONTACT;
                if (ballHeld) {
                    ball.vx = kickBallVx;
                    ball.vz = kickBallVz;
                    ball.vy = kickBallVy;
                    // Push ball out ahead so it clears collision zone
                    const kickDir = Math.sqrt(kickBallVx * kickBallVx + kickBallVz * kickBallVz);
                    if (kickDir &gt; 0.01) {
                        ball.x = player.x + (kickBallVx / kickDir) * (PLAYER_SIZE / 2 + BALL_RADIUS_3D + 0.3);
                        ball.z = player.z + (kickBallVz / kickDir) * (PLAYER_SIZE / 2 + BALL_RADIUS_3D + 0.3);
                    }
                    ballMesh.position.set(ball.x, ball.y, ball.z);
                    ballShadow.position.x = ball.x;
                    ballShadow.position.z = ball.z;
                    ballHeld = false;
                    playKick();
                }
            }
        } else if (kickPhase === &#39;contact&#39;) {
            // Brief hold at full extension
            rightLegPivot.rotation.x = KICK_ANGLE;
            if (kickTimer &lt;= 0) {
                kickPhase = &#39;follow&#39;;
                kickTimer = KICK_FOLLOW;
            }
        } else if (kickPhase === &#39;follow&#39;) {
            // Leg swings back to resting position
            const t = kickTimer / KICK_FOLLOW;  // 1 -&gt; 0
            rightLegPivot.rotation.x = KICK_ANGLE * t;
            if (kickTimer &lt;= 0) {
                kickPhase = &#39;none&#39;;
                rightLegPivot.rotation.x = 0;
            }
        }
    }

    function updateBall(dt) {
        if (!ball.active) return;
        if (ballHeld) return; // ball is held at player&#39;s foot during kick animation

        // Apply gravity after rebound
        if (ball.rebounded) {
            ball.vy -= 0.005 * dt * 60;
            if (ball.y &lt;= BALL_RADIUS_3D &amp;&amp; ball.vy &lt; 0) {
                ball.y = BALL_RADIUS_3D;
                ball.vy = 0;
            }
        }

        ball.x += ball.vx * dt * 60;
        ball.y += ball.vy * dt * 60;
        ball.z += ball.vz * dt * 60;

        // Update mesh
        ballMesh.position.set(ball.x, ball.y, ball.z);
        ballMesh.rotation.x += dt * 5;
        ballMesh.rotation.z += dt * 3;

        // Shadow follows on ground
        ballShadow.position.x = ball.x;
        ballShadow.position.z = ball.z;

        // Collision: distance between ball center and player center (XZ plane)
        const dx = ball.x - player.x;
        const dz = ball.z - player.z;
        const dist = Math.sqrt(dx * dx + dz * dz);
        const catchDist = PLAYER_SIZE / 2 + BALL_RADIUS_3D;

        if (dist &lt;= catchDist &amp;&amp; ball.y &lt; PLAYER_SIZE + BALL_RADIUS_3D &amp;&amp; !ball.rebounded) {
            // Caught — start kick animation, hold ball at foot
            score++;
            ball.rebounded = true;
            updateHUD();

            // Calculate rebound velocity but DON&#39;T apply yet — store it
            const currentSpeed = Math.sqrt(ball.vx * ball.vx + ball.vz * ball.vz);
            const pvx = player.x - player.prevX;
            const pvz = player.z - player.prevZ;
            const pSpeed = Math.sqrt(pvx * pvx + pvz * pvz);

            if (pSpeed &gt; 0.001) {
                kickBallVx = (pvx / pSpeed) * currentSpeed * 1.2;
                kickBallVz = (pvz / pSpeed) * currentSpeed * 1.2;
            } else if (dist &gt; 0.01) {
                kickBallVx = (dx / dist) * currentSpeed * 1.2;
                kickBallVz = (dz / dist) * currentSpeed * 1.2;
            } else {
                kickBallVx = 0;
                kickBallVz = -currentSpeed * 1.2;
            }
            kickBallVy = 0.08;

            // Stop ball movement and hold it at player
            ball.vx = 0;
            ball.vy = 0;
            ball.vz = 0;
            ballHeld = true;

            // Play crowd sounds immediately on catch
            playCrowdCheer();
            playThunderClapStorm();

            // Commentary on save
            saveStreak++;
            statsOnSave();
            if (saveStreak &gt;= 4 &amp;&amp; Math.random() &lt; 0.6) {
                showCommentary(streakComments[Math.floor(Math.random() * streakComments.length)]);
                playCommentatorAmazed();
            } else {
                showCommentary(saveComments[Math.floor(Math.random() * saveComments.length)]);
                playCommentatorExcited();
            }

            // Start kick animation — kick sound plays at leg contact
            kickPhase = &#39;windup&#39;;
            kickTimer = KICK_WINDUP;

            // Push ball to foot position
            if (dist &gt; 0.01) {
                ball.x = player.x + (dx / dist) * (catchDist * 0.6);
                ball.z = player.z + (dz / dist) * (catchDist * 0.6);
            } else {
                ball.z = player.z - (catchDist * 0.6);
            }
        }

        // Missed — ball enters the goal (between the posts, past the goal line)
        const inGoalX = ball.x &gt; -GOAL_WIDTH / 2 &amp;&amp; ball.x &lt; GOAL_WIDTH / 2;
        const pastGoalLine = ball.z &gt; FIELD_DEPTH / 2;
        const belowCrossbar = ball.y &lt; GOAL_HEIGHT;

        if (ball.active &amp;&amp; inGoalX &amp;&amp; pastGoalLine &amp;&amp; belowCrossbar) {
            lives = Math.max(0, lives - 1);
            ball.active = false;
            ballMesh.visible = false;
            ballShadow.visible = false;
            updateHUD();
            playGoal();
            saveStreak = 0; // reset streak on goal
            showCommentary(goalComments[Math.floor(Math.random() * goalComments.length)]);
            playCommentatorDisappointed();

            if (lives &lt;= 0) {
                endGame(true);
            } else {
                canPause = false;
                waitTimer = getInterval(2500);
                waitDuration = waitTimer;
            }
        }

        // Ball went off screen entirely (missed the goal too) — no life lost, just send new ball
        const offMargin = 10;
        if (ball.active &amp;&amp; (
            ball.z &gt; FIELD_DEPTH / 2 + offMargin ||
            ball.x &lt; -FIELD_WIDTH / 2 - offMargin || ball.x &gt; FIELD_WIDTH / 2 + offMargin ||
            ball.z &lt; -FIELD_DEPTH / 2 - offMargin)) {
            ball.active = false;
            ballMesh.visible = false;
            ballShadow.visible = false;
            canPause = true;
            waitTimer = getInterval(2750);
            waitDuration = waitTimer;
        }
    }

    function updateHUD() {
        scoreEl.textContent = &#39;Score: &#39; + score;
        for (let i = 0; i &lt; 3; i++) {
            if (i &lt; lives) {
                heartsEl[i].textContent = &#39;❤️&#39;;
                heartsEl[i].className = &#39;heart&#39;;
            } else {
                heartsEl[i].textContent = &#39;🖤&#39;;
                heartsEl[i].className = &#39;heart lost&#39;;
            }
        }
        if (h2h &amp;&amp; h2h.state === &#39;live&#39; &amp;&amp; score !== h2hLastScoreSent) {
            h2hLastScoreSent = score;
            pushH2HScore(score);
        }
    }

    function updateCenterMessage() {
        centerMsg.innerHTML = &#39;&#39;;
    }

    // ============ GAME LOOP ============
    function gameLoop(timestamp) {
        if (lastTime === 0) lastTime = timestamp;
        const dt = Math.min((timestamp - lastTime) / 1000, 0.05);
        lastTime = timestamp;

        // Always update commentary (so it works on game over screen too)
        updateCommentary(dt);

        if (gameState === &#39;playing&#39;) {
            updatePlayer(dt);
            updateKickAnimation(dt);

            // Wait timer
            if (!ball.active &amp;&amp; waitTimer &gt; 0) {
                waitTimer -= dt * 1000;
                if (waitTimer &lt;= 0) {
                    waitTimer = 0;
                    canPause = false;
                    spawnBall();
                }
            }

            updateBall(dt);
            updateCenterMessage();
        }

        updatePauseBtn();

        // Always render the 3D scene
        renderer.render(scene, camera);
        requestAnimationFrame(gameLoop);
    }

    requestAnimationFrame(gameLoop);
    </script>
  </body>
</html>
