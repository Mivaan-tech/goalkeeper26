    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>
      Goalkeeper26
    </title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
        body { overflow: hidden; background: #1a1a2e; font-family: Arial, sans-serif; }
        canvas { display: block; }

        /* HUD Overlay */
        #hud {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 10;
        }
        #score {
            position: absolute; top: 15px; left: 20px;
            color: #e0e0e0; font-size: 28px; font-weight: bold;
        }
        #playerName {
            position: absolute; top: 50px; left: 20px;
            color: #ffcc02; font-size: 18px; font-weight: bold;
        }
        #usernameInput {
            padding: 12px 20px; font-size: 20px;
            color: #fff; background: rgba(255, 255, 255, 0.12);
            border: 2px solid #3a7bd5; border-radius: 10px;
            margin-bottom: 20px; outline: none; text-align: center;
            pointer-events: auto; width: 260px;
        }
        #usernameInput:focus { border-color: #5c9eff; background: rgba(255, 255, 255, 0.18); }
        #usernameInput::placeholder { color: #888; }
        .btn:disabled { background: #555; cursor: not-allowed; opacity: 0.6; }
        .btn:disabled:hover { background: #555; }
        #hearts {
            position: absolute; top: 15px; right: 20px;
            display: flex; gap: 8px; flex-direction: row-reverse;
        }
        #pauseBtn {
            position: absolute; top: 15px; left: 50%; transform: translateX(-50%);
            width: 44px; height: 44px; border-radius: 50%;
            background: rgba(0, 0, 0, 0.45); color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.3);
            font-size: 20px; cursor: pointer; pointer-events: auto;
            display: flex; align-items: center; justify-content: center;
            padding: 0; line-height: 1;
        }
        #pauseBtn:hover { background: rgba(0, 0, 0, 0.65); }
        #pauseBtn:disabled { opacity: 0.35; cursor: not-allowed; }
        .heart {
            font-size: 30px; color: #ff4757;
        }
        .heart.lost {
            color: #555;
        }
        #centerMessage {
            position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%);
            text-align: center; color: #fff;
        }
        #centerMessage .countdown {
            font-size: 56px; font-weight: bold; color: #ffcc02;
        }
        #centerMessage .subtitle {
            font-size: 22px; color: #aaa; margin-bottom: 10px;
        }

        /* Screens */
        .screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 20; pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        .screen &gt; * { flex-shrink: 0; }
        .screen::before, .screen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        .hidden { display: none !important; }
        #homeScreen { background: rgba(26, 26, 46, 0.85); }
        #loginScreen { background: rgba(26, 26, 46, 0.85); }
        #gameOverScreen { background: rgba(26, 26, 46, 0.85); }
        #pauseScreen { background: rgba(0, 0, 0, 0.5); }

        .screen h1 {
            color: #e0e0e0; font-size: 56px; margin-bottom: 15px; flex-shrink: 0;
        }
        .screen .highscore {
            color: #aaa; font-size: 24px; margin-bottom: 20px; flex-shrink: 0;
        }
        .screen .btn, .screen .btn-small, .screen input { flex-shrink: 0; }
        .screen .final-score {
            color: #e0e0e0; font-size: 34px; margin-bottom: 10px;
        }
        .screen .final-highscore {
            color: #ffcc02; font-size: 24px; margin-bottom: 30px;
        }
        #gameOverScreen h1 {
            color: #ff4757;
        }
        #pauseScreen h1 {
            color: #fff; font-size: 56px;
        }
        #pauseScreen p {
            color: #aaa; font-size: 22px; margin-top: 15px;
        }

        .btn {
            padding: 15px 50px; font-size: 24px; font-weight: bold;
            color: #fff; background: #3a7bd5; border: none; border-radius: 12px;
            cursor: pointer; pointer-events: auto;
        }
        .btn:hover { background: #5c9eff; }
        .btn-small {
            padding: 10px 30px; font-size: 18px; font-weight: bold;
            color: #fff; background: #555; border: none; border-radius: 10px;
            cursor: pointer; pointer-events: auto; margin-top: 15px;
        }
        .btn-small:hover { filter: brightness(1.15); }

        /* Colorful home + game over buttons */
        #friendsBtn { background: #27ae60; }
        #challengesBtn { background: #e67e22; }
        #howToPlayBtn, #howToPlayBtn2 { background: #16a085; }
        #leaderboardBtn, #leaderboardBtn2 { background: #d4910b; }
        #homeBtn { background: #2980b9; }
        #signupBtn { background: #27ae60; }
        #gotItBtn { background: #27ae60; }
        #friendsCloseBtn, #leaderboardCloseBtn, #challengesCloseBtn { background: #2c3e50; }

        #howToPlayScreen, #leaderboardScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #howToPlayScreen &gt; *, #leaderboardScreen &gt; * { flex-shrink: 0; }
        #howToPlayScreen::before, #howToPlayScreen::after,
        #leaderboardScreen::before, #leaderboardScreen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        #howToPlayScreen.visible, #leaderboardScreen.visible { display: flex; }
        #howToPlayScreen h2, #leaderboardScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 20px; }
        #howToPlayScreen ul {
            list-style: none; padding: 0; max-width: 420px; text-align: left;
        }
        #howToPlayScreen li {
            color: #ccc; font-size: 18px; margin-bottom: 12px; line-height: 1.4;
        }
        #howToPlayScreen li span { color: #ffcc02; font-weight: bold; }

        /* Customize screen */
        #customizeScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #customizeScreen.visible { display: flex; }
        #customizeScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 20px; }
        .custom-section { width: 100%; max-width: 460px; margin-bottom: 18px; }
        .custom-label { color: #ffcc02; font-size: 18px; font-weight: bold; margin-bottom: 8px; text-align: left; }
        .swatch-row { display: flex; flex-wrap: wrap; gap: 10px; }
        .swatch {
            width: 38px; height: 38px; border-radius: 50%;
            border: 3px solid transparent; cursor: pointer;
            transition: transform 0.1s, border-color 0.1s;
        }
        .swatch:hover { transform: scale(1.1); }
        .swatch.active { border-color: #fff; transform: scale(1.1); }

        /* Guest mode — hide social features */
        body.guest .guest-hide { display: none !important; }
        #guestHint {
            display: none; color: #888; font-size: 14px;
            margin-bottom: 12px; max-width: 320px; text-align: center;
        }
        body.guest #guestHint { display: block; }

        /* Leaderboard */
        #leaderboardList {
            list-style: none; padding: 0; width: 420px; max-width: 90%;
            max-height: 50vh; overflow-y: auto;
        }
        #leaderboardList li {
            display: flex; align-items: center; justify-content: space-between;
            color: #e0e0e0; font-size: 20px; padding: 10px 16px;
            background: rgba(255, 255, 255, 0.06); border-radius: 8px;
            margin-bottom: 8px;
        }
        #leaderboardList li .rank { color: #aaa; width: 40px; font-weight: bold; }
        #leaderboardList li .name { flex: 1; color: #fff; margin: 0 10px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        #leaderboardList li .score { color: #ffcc02; font-weight: bold; }
        #leaderboardList li.top1 { background: rgba(255, 204, 2, 0.18); }
        #leaderboardList li.top1 .rank { color: #ffcc02; }
        #leaderboardList li.top2 { background: rgba(200, 200, 200, 0.15); }
        #leaderboardList li.top3 { background: rgba(205, 127, 50, 0.18); }
        #leaderboardList li.you { outline: 2px solid #5c9eff; }
        #leaderboardEmpty { color: #888; font-size: 18px; font-style: italic; }

        /* Auth screen */
        #loginScreen input {
            padding: 12px 20px; font-size: 20px;
            color: #fff; background: rgba(255, 255, 255, 0.12);
            border: 2px solid #3a7bd5; border-radius: 10px;
            margin-bottom: 12px; outline: none; text-align: center;
            pointer-events: auto; width: 260px;
        }
        #loginScreen input:focus { border-color: #5c9eff; background: rgba(255, 255, 255, 0.18); }
        #loginScreen input::placeholder { color: #888; }
        .auth-error { color: #ff6b6b; font-size: 16px; margin-top: 12px; min-height: 20px; }
        .auth-hint { color: #888; font-size: 14px; margin-bottom: 14px; max-width: 320px; text-align: center; }
        #loggedInAs { color: #aaa; font-size: 18px; margin-bottom: 14px; }
        #loggedInAs #currentUserLabel { color: #ffcc02; font-weight: bold; }

        /* Friends screen */
        #friendsScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #friendsScreen &gt; * { flex-shrink: 0; }
        #friendsScreen::before, #friendsScreen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        #friendsScreen.visible { display: flex; }
        #friendsScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 20px; }
        .friends-section { width: 420px; max-width: 90%; margin-bottom: 20px; }
        .friends-section h3 { color: #ffcc02; font-size: 18px; margin-bottom: 10px; }
        .add-friend-row { display: flex; gap: 8px; }
        .add-friend-row input {
            flex: 1; padding: 10px 14px; font-size: 16px;
            color: #fff; background: rgba(255, 255, 255, 0.12);
            border: 2px solid #3a7bd5; border-radius: 8px; outline: none;
        }
        .add-friend-row input:focus { border-color: #5c9eff; }
        .add-friend-row button { margin-top: 0; }
        .friend-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; background: rgba(255, 255, 255, 0.06);
            border-radius: 8px; margin-bottom: 6px; color: #fff; font-size: 16px;
        }
        .friend-row .friend-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .friend-row .friend-score { color: #ffcc02; font-weight: bold; }
        .friend-row .friend-action {
            padding: 6px 12px; font-size: 13px; border: none; border-radius: 6px;
            cursor: pointer; color: #fff; font-weight: bold;
        }
        .friend-row .accept { background: #27ae60; }
        .friend-row .accept:hover { background: #2ecc71; }
        .friend-row .decline { background: #c0392b; }
        .friend-row .decline:hover { background: #e74c3c; }
        .friend-row .remove { background: #555; }
        .friend-row .remove:hover { background: #777; }
        .friends-empty { color: #888; font-size: 15px; font-style: italic; }
        .friends-msg { color: #5c9eff; font-size: 14px; margin-top: 6px; min-height: 18px; }
        .friends-msg.error { color: #ff6b6b; }
        .friend-row .challenge { background: #d4910b; }
        .friend-row .challenge:hover { background: #f0a61e; }

        /* Challenges screen */
        #challengesScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #challengesScreen &gt; * { flex-shrink: 0; }
        #challengesScreen::before, #challengesScreen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        #challengesScreen.visible { display: flex; }
        #challengesScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 20px; }
        .challenge-row {
            display: flex; flex-direction: column; gap: 6px;
            padding: 12px 14px; background: rgba(255, 255, 255, 0.06);
            border-radius: 8px; margin-bottom: 8px; color: #fff;
        }
        .challenge-row .ch-header { display: flex; justify-content: space-between; align-items: center; }
        .challenge-row .ch-from { color: #ffcc02; font-weight: bold; font-size: 16px; }
        .challenge-row .ch-target { color: #ccc; font-size: 14px; }
        .challenge-row .ch-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px; }
        .challenge-row .ch-result {
            font-size: 14px; padding: 6px 10px; border-radius: 6px;
            background: rgba(255, 255, 255, 0.04);
        }
        .challenge-row .ch-result.win { color: #2ecc71; }
        .challenge-row .ch-result.loss { color: #ff6b6b; }
        .challenge-row .ch-result.pending { color: #aaa; font-style: italic; }
        .ch-action-btn {
            padding: 6px 12px; font-size: 13px; border: none; border-radius: 6px;
            cursor: pointer; color: #fff; font-weight: bold;
        }
        .ch-action-btn.play { background: #27ae60; }
        .ch-action-btn.play:hover { background: #2ecc71; }
        .ch-action-btn.dismiss { background: #555; }
        .ch-action-btn.dismiss:hover { background: #777; }

        /* Challenge badge on home */
        #challengesBtn { position: relative; }
        .ch-badge {
            position: absolute; top: -6px; right: -6px;
            background: #e74c3c; color: #fff;
            font-size: 12px; font-weight: bold;
            min-width: 20px; height: 20px; padding: 0 6px;
            border-radius: 10px; display: none;
            align-items: center; justify-content: center;
            line-height: 1;
        }
        .ch-badge.visible { display: inline-flex; }

        /* Challenge target indicator during gameplay */
        #challengeTargetHUD {
            position: absolute; top: 55px; left: 50%; transform: translateX(-50%);
            color: #ffcc02; font-size: 16px; font-weight: bold;
            background: rgba(0, 0, 0, 0.5); padding: 4px 12px; border-radius: 6px;
            display: none; pointer-events: none;
        }
        #challengeTargetHUD.visible { display: block; }

        /* H2H opponent score HUD */
        #h2hOpponentHUD {
            position: absolute; top: 15px; left: 50%; transform: translateX(-50%);
            color: #ff6b6b; font-size: 20px; font-weight: bold;
            background: rgba(0, 0, 0, 0.55); padding: 6px 16px; border-radius: 8px;
            display: none; pointer-events: none; text-align: center;
        }
        #h2hOpponentHUD.visible { display: block; }
        #h2hOpponentHUD .h2h-name { font-size: 13px; color: #ccc; font-weight: normal; }

        /* H2H lobby/result overlay */
        #h2hOverlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(26, 26, 46, 0.92);
            display: none; flex-direction: column; align-items: center; justify-content: center;
            z-index: 35; pointer-events: auto; padding: 30px 20px; text-align: center;
        }
        #h2hOverlay.visible { display: flex; }
        #h2hOverlay h2 { color: #e0e0e0; font-size: 38px; margin-bottom: 12px; }
        #h2hOverlay .h2h-sub { color: #aaa; font-size: 18px; margin-bottom: 18px; }
        #h2hOverlay .h2h-countdown { color: #ffcc02; font-size: 84px; font-weight: bold; margin: 20px 0; }
        #h2hOverlay .h2h-players {
            display: flex; gap: 30px; align-items: center; justify-content: center;
            margin: 20px 0; font-size: 22px;
        }
        #h2hOverlay .h2h-player {
            padding: 12px 18px; background: rgba(255, 255, 255, 0.08); border-radius: 10px;
            min-width: 120px;
        }
        #h2hOverlay .h2h-player.you { outline: 2px solid #5c9eff; color: #5c9eff; }
        #h2hOverlay .h2h-score { font-size: 36px; font-weight: bold; color: #ffcc02; margin-top: 4px; }
        #h2hOverlay .h2h-vs { color: #888; font-size: 20px; }
        #h2hOverlay .h2h-actions { margin-top: 20px; display: flex; gap: 10px; }
        #h2hOverlay .h2h-result-winner { font-size: 28px; color: #2ecc71; margin-bottom: 8px; }
        #h2hOverlay .h2h-result-loser { font-size: 22px; color: #ff6b6b; }
        #h2hOverlay .h2h-result-tie { font-size: 28px; color: #ffcc02; }

        /* H2H invite button */
        .friend-row .h2h-btn { background: #8e44ad; }
        .friend-row .h2h-btn:hover { background: #a568c9; }

        /* Achievements */
        #achievementsScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #achievementsScreen &gt; * { flex-shrink: 0; }
        #achievementsScreen::before, #achievementsScreen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        #achievementsScreen.visible { display: flex; }
        #achievementsScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 10px; }
        #achievementsProgress { color: #aaa; font-size: 16px; margin-bottom: 20px; }
        #achievementsGrid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 8px;
            width: 1080px; max-width: 98%;
        }
        .ach-card {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 10px; background: rgba(255, 255, 255, 0.06);
            border-radius: 8px; color: #fff;
        }
        .ach-card.locked { opacity: 0.45; }
        .ach-card.unlocked { background: rgba(39, 174, 96, 0.2); }
        .ach-icon { font-size: 24px; flex-shrink: 0; width: 32px; text-align: center; }
        .ach-body { flex: 1; min-width: 0; }
        .ach-name { font-size: 14px; font-weight: bold; color: #fff;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ach-desc { font-size: 12px; color: #ccc; margin-top: 1px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ach-card.unlocked .ach-name { color: #2ecc71; }
        .ach-card.locked .ach-icon { filter: grayscale(1); }

        #achievementsBtn { background: #c0392b; }
        #playersBtn { background: #8e44ad; }

        /* Players screen */
        #playersScreen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; align-items: center; justify-content: flex-start;
            z-index: 30; background: rgba(26, 26, 46, 0.92); pointer-events: auto;
            overflow-y: auto; padding: 30px 20px;
        }
        #playersScreen &gt; * { flex-shrink: 0; }
        #playersScreen::before, #playersScreen::after {
            content: &#34;&#34;; flex: 1 1 0; min-height: 20px;
        }
        #playersScreen.visible { display: flex; }
        #playersScreen h2 { color: #e0e0e0; font-size: 36px; margin-bottom: 10px; }
        #playersFilterInput {
            width: 420px; max-width: 95%;
            padding: 10px 14px; font-size: 16px; margin-bottom: 14px;
            color: #fff; background: rgba(255, 255, 255, 0.12);
            border: 2px solid #3a7bd5; border-radius: 8px; outline: none;
        }
        #playersFilterInput:focus { border-color: #5c9eff; }
        #playersList { width: 460px; max-width: 95%; }
        .player-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; background: rgba(255, 255, 255, 0.06);
            border-radius: 8px; margin-bottom: 6px; color: #fff; font-size: 16px;
            cursor: pointer;
        }
        .player-row:hover { background: rgba(255, 255, 255, 0.12); }
        .player-row.is-you { outline: 2px solid #5c9eff; }
        .player-row.is-friend { background: rgba(39, 174, 96, 0.18); }
        .player-row .p-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .player-row .p-you-tag { color: #5c9eff; font-size: 12px; font-weight: bold; }
        .player-row .p-friend-tag { color: #2ecc71; font-size: 12px; font-weight: bold; }
        .player-row .p-best { color: #ffcc02; font-weight: bold; font-size: 14px; }
        .player-row .p-add {
            padding: 6px 12px; font-size: 12px; border: none; border-radius: 6px;
            cursor: pointer; color: #fff; font-weight: bold; background: #3a7bd5;
        }
        .player-row .p-add:hover { background: #5c9eff; }
        .player-row .p-add:disabled { background: #555; cursor: not-allowed; }

        /* Toast */
        #achievementToast {
            position: absolute; top: 20px; left: 50%; transform: translateX(-50%) translateY(-150%);
            background: rgba(0, 0, 0, 0.85); color: #fff;
            padding: 12px 20px; border-radius: 10px;
            border: 2px solid #ffcc02; box-shadow: 0 4px 24px rgba(255, 204, 2, 0.4);
            font-size: 16px; font-weight: bold; z-index: 50;
            display: flex; align-items: center; gap: 12px;
            transition: transform 0.4s ease-out; pointer-events: none;
            max-width: 90%;
        }
        #achievementToast.visible { transform: translateX(-50%) translateY(0); }
        #achievementToast .toast-icon { font-size: 28px; }
        #achievementToast .toast-label { color: #ffcc02; font-size: 12px; font-weight: normal; }
        #achievementToast .toast-name { font-size: 16px; }

        /* Modal */
        .modal-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7); display: none;
            align-items: center; justify-content: center;
            z-index: 40; pointer-events: auto; padding: 20px;
        }
        .modal-overlay.visible { display: flex; }
        .modal {
            background: #2a2a4e; border-radius: 12px; padding: 25px 30px;
            max-width: 380px; width: 100%;
        }
