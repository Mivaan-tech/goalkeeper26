    // ============ HEAD-TO-HEAD ============
    const FB_MATCHES = &#39;/goalkeeper/matches&#39;;
    const FB_USER_MATCHES = &#39;/goalkeeper/userMatches&#39;;
    const h2hOverlayEl = document.getElementById(&#39;h2hOverlay&#39;);
    const h2hContentEl = document.getElementById(&#39;h2hContent&#39;);
