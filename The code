    function playKick() {
        const ctx = getAudioCtx();
        // Short punchy kick sound
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.setValueAtTime(200, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.5, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.15);
        // Add a noise burst for impact
        const bufferSize = ctx.sampleRate * 0.05;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i &lt; bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const noiseGain = ctx.createGain();
        noise.connect(noiseGain);
        noiseGain.connect(ctx.destination);
        noiseGain.gain.setValueAtTime(0.3, ctx.currentTime);
        noiseGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.05);
        noise.start(ctx.currentTime);
    }

    // --- Disappointing goal sounds (randomly picked) ---
    function playGoalSadTrombone() {
        const ctx = getAudioCtx();
        // Classic &#34;wah wah wah waaah&#34; sad trombone
        const notes = [392, 370, 349, 261]; // G4, F#4, F4, C4
        const durations = [0.25, 0.25, 0.25, 0.6];
        let t = ctx.currentTime;
        notes.forEach((freq, i) =&gt; {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.type = &#39;sawtooth&#39;;
            osc.frequency.setValueAtTime(freq, t);
            // Add vibrato on the last long note
            if (i === 3) {
                osc.frequency.setValueAtTime(freq, t);
                osc.frequency.linearRampToValueAtTime(freq * 0.92, t + durations[i]);
            }
            gain.gain.setValueAtTime(0.25, t);
            gain.gain.linearRampToValueAtTime(0.2, t + durations[i] * 0.7);
            gain.gain.linearRampToValueAtTime(0, t + durations[i]);
            osc.start(t);
            osc.stop(t + durations[i]);
            t += durations[i];
        });
    }

    function playGoalCrowdGroan() {
        const ctx = getAudioCtx();
        const duration = 1.0;
        // Deep rumbling groan — disappointed crowd
        const buf = ctx.createBuffer(1, ctx.sampleRate * duration, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i &lt; d.length; i++) {
            const t = i / ctx.sampleRate;
            // Envelope: quick rise, slow fade
            const env = Math.min(t / 0.08, 1) * Math.pow(1 - t / duration, 0.6);
            d[i] = (Math.random() * 2 - 1) * env;
        }
        const src = ctx.createBufferSource();
        src.buffer = buf;
        // Low-pass filter to make it deep and rumbly
        const filt = ctx.createBiquadFilter();
        filt.type = &#39;lowpass&#39;;
        filt.frequency.setValueAtTime(500, ctx.currentTime);
        filt.frequency.linearRampToValueAtTime(250, ctx.currentTime + duration);
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.5, ctx.currentTime);
        g.gain.linearRampToValueAtTime(0, ctx.currentTime + duration);
        src.connect(filt);
        filt.connect(g);
        g.connect(ctx.destination);
        src.start(ctx.currentTime);
        // Add a descending &#34;ohhh&#34; tone underneath
        const osc = ctx.createOscillator();
        const oGain = ctx.createGain();
        osc.connect(oGain);
        oGain.connect(ctx.destination);
        osc.type = &#39;sine&#39;;
        osc.frequency.setValueAtTime(250, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + duration);
        oGain.gain.setValueAtTime(0.15, ctx.currentTime);
        oGain.gain.linearRampToValueAtTime(0, ctx.currentTime + duration);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + duration);
    }

    function playGoalBuzzer() {
