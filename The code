    function submitScore(name, newScore) {
        const entry = { name: name, score: newScore, date: Date.now() };

        // Local cache (instant, offline-safe)
        const list = loadLocalLeaderboard();
        list.push(entry);
        list.sort((a, b) =&gt; b.score - a.score);
        saveLocalLeaderboard(list.slice(0, LEADERBOARD_MAX));

        // Push to Firebase (shared across devices)
        fetch(FB_URL + FB_LB_PATH + &#39;.json&#39;, {
            method: &#39;POST&#39;,
            headers: { &#39;Content-Type&#39;: &#39;application/json&#39; },
            body: JSON.stringify(entry)
        }).catch(() =&gt; {});
    }

    async function fetchCloudLeaderboard() {
        const res = await fetch(FB_URL + FB_LB_PATH + &#39;.json&#39;);
        if (!res.ok) throw new Error(&#39;fetch failed&#39;);
        const data = await res.json();
        if (!data) return [];
        return Object.values(data).filter(e =&gt; e &amp;&amp; typeof e.name === &#39;string&#39; &amp;&amp; typeof e.score === &#39;number&#39;);
    }

    function renderLeaderboardList(list, highlightName, highlightScore) {
        leaderboardList.innerHTML = &#39;&#39;;
        if (!list || list.length === 0) {
            leaderboardEmpty.textContent = &#39;No scores yet — be the first!&#39;;
            leaderboardEmpty.style.display = &#39;block&#39;;
            leaderboardList.style.display = &#39;none&#39;;
            return;
        }
        leaderboardEmpty.style.display = &#39;none&#39;;
        leaderboardList.style.display = &#39;block&#39;;
        let highlightedOnce = false;
        list.forEach((entry, i) =&gt; {
            const li = document.createElement(&#39;li&#39;);
            const rankClass = i === 0 ? &#39;top1&#39; : i === 1 ? &#39;top2&#39; : i === 2 ? &#39;top3&#39; : &#39;&#39;;
            if (rankClass) li.classList.add(rankClass);
            if (!highlightedOnce &amp;&amp; highlightName != null &amp;&amp;
                entry.name === highlightName &amp;&amp; entry.score === highlightScore) {
                li.classList.add(&#39;you&#39;);
                highlightedOnce = true;
            }
            const rank = document.createElement(&#39;span&#39;);
            rank.className = &#39;rank&#39;;
            rank.textContent = &#39;#&#39; + (i + 1);
            const nameEl = document.createElement(&#39;span&#39;);
            nameEl.className = &#39;name&#39;;
            nameEl.textContent = entry.name;
            const scoreEl = document.createElement(&#39;span&#39;);
            scoreEl.className = &#39;score&#39;;
            scoreEl.textContent = entry.score;
            li.appendChild(rank);
            li.appendChild(nameEl);
            li.appendChild(scoreEl);
            leaderboardList.appendChild(li);
        });
    }

    async function openLeaderboard(highlightName, highlightScore) {
