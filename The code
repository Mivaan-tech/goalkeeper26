    async function syncStatsFromCloud() {
        if (!username) return;
        try {
            const data = await fbGet(FB_USERS + &#39;/&#39; + username);
            if (data &amp;&amp; data.stats) {
                Object.keys(userStats).forEach(k =&gt; {
                    if (typeof data.stats[k] === &#39;number&#39; &amp;&amp; data.stats[k] &gt; userStats[k]) {
                        userStats[k] = data.stats[k];
                    }
                });
            }
            if (data &amp;&amp; data.achievements) {
                Object.keys(data.achievements).forEach(id =&gt; {
                    if (!unlockedAchievements[id]) unlockedAchievements[id] = data.achievements[id];
                });
            }
            saveLocalStats();
            checkAchievements();
        } catch (e) {}
    }

    async function pushStatsToCloud() {
