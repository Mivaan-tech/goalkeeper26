    function renderH2HResult(match) {
        const mine = (h2h &amp;&amp; h2h.role === &#39;host&#39;) ? match.hostScore : match.guestScore;
        const theirs = (h2h &amp;&amp; h2h.role === &#39;host&#39;) ? match.guestScore : match.hostScore;
        const mineName = (h2h &amp;&amp; h2h.role === &#39;host&#39;) ? match.host : match.guest;
        const theirName = (h2h &amp;&amp; h2h.role === &#39;host&#39;) ? match.guest : match.host;
        let verdict;
        if (mine &gt; theirs) { verdict = &#39;&lt;div class=&#34;h2h-result-winner&#34;&gt;🏆 You Win!&lt;/div&gt;&#39;; statsOnH2HWon(); }
        else if (theirs &gt; mine) verdict = &#39;&lt;div class=&#34;h2h-result-loser&#34;&gt;&#39; + theirName + &#39; wins&lt;/div&gt;&#39;;
        else verdict = &#39;&lt;div class=&#34;h2h-result-tie&#34;&gt;🤝 Tie!&lt;/div&gt;&#39;;
        showH2HOverlay(
            &#39;&lt;h2&gt;Match Over&lt;/h2&gt;&#39; +
            verdict +
            &#39;&lt;div class=&#34;h2h-players&#34;&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-player you&#34;&gt;&#39; + mineName + &#39;&lt;div class=&#34;h2h-score&#34;&gt;&#39; + (mine || 0) + &#39;&lt;/div&gt;&lt;/div&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-vs&#34;&gt;VS&lt;/div&gt;&#39; +
                &#39;&lt;div class=&#34;h2h-player&#34;&gt;&#39; + theirName + &#39;&lt;div class=&#34;h2h-score&#34;&gt;&#39; + (theirs || 0) + &#39;&lt;/div&gt;&lt;/div&gt;&#39; +
            &#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;h2h-actions&#34;&gt;&lt;button class=&#34;ch-action-btn play&#34; id=&#34;h2hDoneBtn&#34;&gt;Back to Home&lt;/button&gt;&lt;/div&gt;&#39;
        );
        const btn = document.getElementById(&#39;h2hDoneBtn&#39;);
        if (btn) btn.addEventListener(&#39;click&#39;, async () =&gt; {
            hideH2HOverlay();
            h2hOpponentHUDEl.classList.remove(&#39;visible&#39;);
            if (h2h &amp;&amp; h2h.matchId) {
                try { await fbDelete(FB_USER_MATCHES + &#39;/&#39; + username + &#39;/active&#39;); } catch (e) {}
            }
            h2h = null;
            h2hRng = null;
            gameState = &#39;home&#39;;
            gameOverScreen.classList.add(&#39;hidden&#39;);
